# ─────────────────────────────────────────
# Konfigurasi Aplikasi PPE Detection
# ─────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model — path relatif dari folder ppe-be/
MODEL_PATH=models/weights/best.onnx

# Confidence threshold (diturunkan agar deteksi lebih sensitif)
CONFIDENCE_THRESHOLD=0.40

# IOU threshold untuk NMS
IOU_THRESHOLD=0.45

# Label kelas — HARUS sesuai urutan output model (4 kelas)
CLASS_NAMES=complete_vest_helmet,no_helmet,no_vest,no_vest_no_helmet
