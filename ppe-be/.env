# ─────────────────────────────────────────
# Konfigurasi Aplikasi PPE Detection
# Salin file ini menjadi .env dan sesuaikan
# ─────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=8000

# CORS — pisahkan dengan koma jika lebih dari satu origin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model
# Isi dengan path ke file model Anda (.pt untuk YOLO, .h5 untuk TF, dsb.)
MODEL_PATH=models/weights/best.pt

# Confidence threshold (0.0 – 1.0)
# Deteksi di bawah nilai ini akan diabaikan
CONFIDENCE_THRESHOLD=0.60

# Label kelas yang dideteksi model Anda
# Pastikan urutan sesuai dengan training model
CLASS_NAMES=helmet,vest
